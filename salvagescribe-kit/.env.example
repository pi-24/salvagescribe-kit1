# --- LLM provider config (used by src/llm.js) ---
# Base URL for the OpenAI-compatible chat/completions endpoint
LLM_BASE_URL=https://api.example.com/v1
# API key
LLM_API_KEY=sk-replace-me
# Model name (pin one for reproducible demo outputs; use "auto" while building)
LLM_MODEL=auto

# Set MOCK=1 to return canned responses from data/mock_responses/ (zero credits)
MOCK=0

# Server
PORT=3000
